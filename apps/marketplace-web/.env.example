# Backend base URL. While mocks are on, MSW intercepts it so nothing has to be running there.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# true = MSW mocks every endpoint. false = call the real API at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_ENABLE_MOCKS=true
# Stripe publishable key. Keep the mock value for the built-in fallback card form (no network).
# Use a real pk_test_... key to render Stripe Elements; confirmPayment is still mocked.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mitdrone_mock
# Public URLs, used for canonical links, OpenGraph and cross-app links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VENDOR_URL=http://localhost:3001
# Server-side mock signing only; browser MSW uses a public demo fallback. Mock JWTs are not secure.
# Production auth must use backend-issued httpOnly cookies.
NEXTAUTH_SECRET=mitdrone-dev-secret-change-me
