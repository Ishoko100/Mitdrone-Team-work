# Backend base URL. While mocks are on, MSW intercepts it so nothing has to be running there.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# true = MSW mocks every endpoint. false = call the real API at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_ENABLE_MOCKS=true
# Where the public storefront lives (for "View store" links).
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Kept for parity with the other apps. The vendor dashboard does not take payments.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mitdrone_mock
