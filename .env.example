# Root reference. Copy the matching app .env.example into that app as .env.local when needed.

# Base URL of the backend API. While mocks are enabled, MSW intercepts this URL, so nothing needs to run there.
# Backend dev: point this at the real API and set NEXT_PUBLIC_ENABLE_MOCKS=false.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# true = MSW mocks every endpoint (no backend needed). false = real API.
NEXT_PUBLIC_ENABLE_MOCKS=true

# Server-side mock signing only; browser MSW uses a public demo fallback. Mock JWTs are not secure.
# Production auth must use backend-issued httpOnly cookies.
NEXTAUTH_SECRET=mitdrone-dev-secret-change-me

# Stripe test publishable key. No real charges are made: confirmPayment is intercepted by the mock layer.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mitdrone_mock
